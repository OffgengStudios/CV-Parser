APP_NAME=CV Parser API
APP_VERSION=1.0.0
DEBUG=False

# Security - set a long random value in production.
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:3000

# Storage
UPLOAD_DIR=uploads
LOG_DIR=logs
MAX_FILE_SIZE_MB=10

# Database
DATABASE_URL=postgresql://user:password@host:5432/cv_system
MIN_CONFIDENCE_SCORE=0.1

# Google Sheets integration. Leave empty if unused.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Use this on Render instead of GOOGLE_SERVICE_ACCOUNT_FILE. Paste the full
# service account JSON on one line and share the spreadsheet with its
# client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Sheet1
GOOGLE_SHEETS_ANALYTICS_TAB_NAME=Batch Analytics

# WhatsApp integration. Leave empty if unused.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_MAX_ATTEMPTS=3
REDIS_URL=redis://localhost:6379/0
